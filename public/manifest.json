{
  "manifest_version": 3,
  "name": "Phase Pal Music Bridge",
  "description": "Connect supported browser music to Phase Pal Dance to Music.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "offscreen",
    "tabCapture",
    "scripting"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "https://www.soundcloud.com/*",
    "https://music.apple.com/*",
    "https://music.amazon.com/*",
    "https://music.amazon.co.uk/*",
    "https://music.amazon.de/*",
    "https://music.amazon.fr/*",
    "https://music.amazon.it/*",
    "https://music.amazon.es/*",
    "https://music.amazon.co.jp/*",
    "https://music.amazon.in/*",
    "https://music.amazon.com.au/*",
    "https://music.amazon.com.br/*",
    "https://music.amazon.ca/*",
    "https://music.amazon.com.mx/*",
    "https://www.deezer.com/*",
    "https://deezer.com/*",
    "https://listen.tidal.com/*",
    "https://play.qobuz.com/*",
    "https://www.pandora.com/*",
    "https://pandora.com/*",
    "https://music.yandex.com/*",
    "https://music.yandex.ru/*",
    "https://y.qq.com/*",
    "https://www.kugou.com/*",
    "https://www.jiosaavn.com/*",
    "https://music.line.me/*",
    "https://music.bugs.co.kr/*",
    "https://www.joox.com/*",
    "https://joox.com/*",
    "https://play.anghami.com/*",
    "https://audiomack.com/*",
    "https://www.audiomack.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Phase Pal Music Bridge",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://music.youtube.com/*",
        "https://soundcloud.com/*",
        "https://www.soundcloud.com/*",
        "https://music.apple.com/*",
        "https://music.amazon.com/*",
        "https://music.amazon.co.uk/*",
        "https://music.amazon.de/*",
        "https://music.amazon.fr/*",
        "https://music.amazon.it/*",
        "https://music.amazon.es/*",
        "https://music.amazon.co.jp/*",
        "https://music.amazon.in/*",
        "https://music.amazon.com.au/*",
        "https://music.amazon.com.br/*",
        "https://music.amazon.ca/*",
        "https://music.amazon.com.mx/*",
        "https://www.deezer.com/*",
        "https://deezer.com/*",
        "https://listen.tidal.com/*",
        "https://play.qobuz.com/*",
        "https://www.pandora.com/*",
        "https://pandora.com/*",
        "https://music.yandex.com/*",
        "https://music.yandex.ru/*",
        "https://y.qq.com/*",
        "https://www.kugou.com/*",
        "https://www.jiosaavn.com/*",
        "https://music.line.me/*",
        "https://music.bugs.co.kr/*",
        "https://www.joox.com/*",
        "https://joox.com/*",
        "https://play.anghami.com/*",
        "https://audiomack.com/*",
        "https://www.audiomack.com/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
