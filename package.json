{
  "name": "phasepal-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --mode content",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "package:store": "npm run check && python scripts/package-store.py"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
